HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
COMFYUI_URL=http://127.0.0.1:8188
# Set SECURE_COOKIE=1 when the app is served through HTTPS.
SECURE_COOKIE=0
# Required for network deployment; keep the backend behind a trusted HTTPS proxy.
# APP_ORIGIN=https://images.example.com
# Optional preconfigured bootstrap secret (32+ random URL-safe characters).
# Otherwise the first run creates DATA_DIR/.setup-token with owner-only access.
# Per-account saved-image quota (default 20 GiB); a 1 GiB disk reserve is enforced.
MAX_USER_IMAGE_BYTES=21474836480
# Used only by npm run setup:admin on an empty database.
ADMIN_USERNAME=DeepGHS
ADMIN_PASSWORD=
